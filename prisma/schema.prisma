generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─── Multi-Tenant: Organizations ────────────────────────────────
model Organization {
  id             String   @id @default(cuid())
  name           String
  slug           String   @unique
  logo           String?
  plan           Plan     @default(FREE)
  isActive       Boolean  @default(true)
  website        String?
  address        String?
  city           String?
  zip            String?
  country        String?  @default("Schweiz")
  industry       String?
  contactPerson  String?
  contactEmail   String?
  contactPhone   String?
  socialMedia    Json?
  shareToken     String?  @unique
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  members      OrganizationMember[]
  clients      Client[]
  scenarios    Scenario[]
  reports      Report[]
  integrations Integration[]
  metrics      Metric[]
  emailLists   EmailList[]
  campaigns    Campaign[]

  @@map("organizations")
}

enum Plan {
  FREE
  STARTER
  PROFESSIONAL
  ENTERPRISE
}

// ─── Users ──────────────────────────────────────────────────────
model User {
  id            String    @id @default(cuid())
  email         String    @unique
  name          String?
  passwordHash  String
  image         String?
  globalRole    GlobalRole @default(USER)
  isActive      Boolean    @default(true)
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  memberships   OrganizationMember[]
  sessions      Session[]
  accounts      Account[]

  @@map("users")
}

enum GlobalRole {
  SUPER_ADMIN
  USER
}

// ─── Organization Membership (Role per Org) ─────────────────────
model OrganizationMember {
  id             String         @id @default(cuid())
  userId         String
  organizationId String
  role           OrgRole        @default(VIEWER)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  user           User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization   Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([userId, organizationId])
  @@map("organization_members")
}

enum OrgRole {
  OWNER
  ADMIN
  EDITOR
  VIEWER
}

// ─── NextAuth Accounts & Sessions ───────────────────────────────
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

// ─── Clients (per Organization) ─────────────────────────────────
model Client {
  id             String       @id @default(cuid())
  organizationId String
  name           String
  industry       String?
  website        String?
  contactEmail   String?
  contactPhone   String?
  isActive       Boolean      @default(true)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  scenarios      Scenario[]
  integrations   Integration[]

  @@map("clients")
}

// ─── Scenarios ──────────────────────────────────────────────────
model Scenario {
  id             String       @id @default(cuid())
  organizationId String
  clientId       String?
  title          String
  description    String?
  status         ScenarioStatus @default(DRAFT)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  client         Client?      @relation(fields: [clientId], references: [id], onDelete: SetNull)

  @@map("scenarios")
}

enum ScenarioStatus {
  DRAFT
  ACTIVE
  PAUSED
  COMPLETED
  ARCHIVED
}

// ─── Reports ────────────────────────────────────────────────────
model Report {
  id             String       @id @default(cuid())
  organizationId String
  title          String
  type           ReportType
  data           Json?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@map("reports")
}

enum ReportType {
  EMOTION_ANALYSIS
  SENTIMENT_TREND
  ENGAGEMENT
  CUSTOM
}

// ─── Platform Integrations ──────────────────────────────────────
model Integration {
  id             String       @id @default(cuid())
  organizationId String
  clientId       String?
  platform       Platform
  accessToken    String?
  refreshToken   String?
  tokenExpiresAt DateTime?
  externalId     String?      // Platform-specific account/page ID
  externalName   String?      // Display name from the platform
  scopes         String?      // Comma-separated scopes granted
  status         IntegrationStatus @default(DISCONNECTED)
  lastSyncAt     DateTime?
  lastSyncError  String?
  metadata       Json?        // Platform-specific config
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  client         Client?      @relation(fields: [clientId], references: [id], onDelete: SetNull)
  metrics        Metric[]

  @@unique([organizationId, platform, externalId])
  @@map("integrations")
}

enum Platform {
  GOOGLE_ANALYTICS
  SEARCH_CONSOLE
  INSTAGRAM
  FACEBOOK
  YOUTUBE
  LINKEDIN
  TIKTOK
}

enum IntegrationStatus {
  CONNECTED
  DISCONNECTED
  ERROR
  SYNCING
}

// ─── Metrics (Time-series data from platforms) ──────────────────
model Metric {
  id             String   @id @default(cuid())
  organizationId String
  integrationId  String
  platform       Platform
  metricName     String   // e.g. "sessions", "followers", "impressions"
  metricValue    Float
  dimensions     Json?    // e.g. {"source": "organic", "query": "keyword"}
  period         String   // e.g. "2026-04-09", "2026-W15"
  collectedAt    DateTime @default(now())

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  integration    Integration  @relation(fields: [integrationId], references: [id], onDelete: Cascade)

  @@index([organizationId, platform, metricName, period])
  @@index([integrationId, metricName, period])
  @@map("metrics")
}

// ─── E-Mail Marketing ───────────────────────────────────────────
model EmailList {
  id             String       @id @default(cuid())
  organizationId String
  name           String
  description    String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  subscribers    Subscriber[]
  campaigns      Campaign[]

  @@map("email_lists")
}

model Subscriber {
  id          String           @id @default(cuid())
  listId      String
  email       String
  firstName   String?
  lastName    String?
  status      SubscriberStatus @default(ACTIVE)
  tags        String?          // comma-separated
  subscribedAt DateTime        @default(now())
  unsubscribedAt DateTime?

  list        EmailList        @relation(fields: [listId], references: [id], onDelete: Cascade)

  @@unique([listId, email])
  @@map("subscribers")
}

enum SubscriberStatus {
  ACTIVE
  UNSUBSCRIBED
  BOUNCED
}

model Campaign {
  id             String         @id @default(cuid())
  organizationId String
  listId         String?
  name           String
  subject        String
  previewText    String?
  htmlContent    String?
  status         CampaignStatus @default(DRAFT)
  scheduledAt    DateTime?
  sentAt         DateTime?
  totalSent      Int            @default(0)
  totalOpened    Int            @default(0)
  totalClicked   Int            @default(0)
  totalBounced   Int            @default(0)
  totalUnsubscribed Int         @default(0)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  organization   Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  list           EmailList?     @relation(fields: [listId], references: [id], onDelete: SetNull)

  @@map("campaigns")
}

model PlatformCredential {
  id               String   @id @default(cuid())
  platform         Platform @unique
  clientId         String
  clientSecret     String
  additionalConfig Json?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@map("platform_credentials")
}

// ─── Sales Intelligence / Kundenakquise ─────────────────────────
model Lead {
  id              String     @id @default(cuid())
  name            String
  industry        String
  website         String?
  phone           String?
  email           String?
  address         String?
  city            String?
  zip             String?
  canton          String?
  googlePlaceId   String?    @unique
  googleRating    Float?
  googleReviews   Int?
  socialMedia     Json?
  status          LeadStatus @default(NEU)
  score           Int?
  analysis        Json?
  recommendations Json?
  websiteScore    Int?
  socialScore     Int?
  seoScore        Int?
  potentialValue  String?
  searchBatch     String?
  analyzedAt      DateTime?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  notes           LeadNote[]
  activities      LeadActivity[]
  reminders       LeadReminder[]

  @@index([status])
  @@index([industry])
  @@index([score])
  @@map("leads")
}

enum LeadStatus {
  NEU
  RECHERCHIERT
  ANGESCHRIEBEN
  FOLLOW_UP
  ANTWORT
  TERMIN
  OFFERTE
  KUNDE
  ABGELEHNT
}

model LeadNote {
  id        String   @id @default(cuid())
  leadId    String
  content   String
  authorId  String?
  authorName String?
  createdAt DateTime @default(now())

  lead      Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([leadId])
  @@map("lead_notes")
}

model LeadActivity {
  id        String   @id @default(cuid())
  leadId    String
  type      String
  message   String
  metadata  Json?
  authorId  String?
  authorName String?
  createdAt DateTime @default(now())

  lead      Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([leadId])
  @@map("lead_activities")
}

model LeadReminder {
  id        String   @id @default(cuid())
  leadId    String
  title     String
  dueDate   DateTime
  completed Boolean  @default(false)
  authorId  String?
  createdAt DateTime @default(now())

  lead      Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([leadId])
  @@index([dueDate])
  @@map("lead_reminders")
}

model SuppressionEntry {
  id        String   @id @default(cuid())
  type      String
  value     String
  reason    String?
  createdAt DateTime @default(now())

  @@unique([type, value])
  @@map("suppression_list")
}

model AkquiseConfig {
  id          String   @id @default(cuid())
  branches    Json
  regions     Json
  isActive    Boolean  @default(true)
  searchTime  String   @default("02:00")
  maxResults  Int      @default(30)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("akquise_config")
}

// ─── KI-Lernsystem ──────────────────────────────────────────────
model AiReference {
  id          String   @id @default(cuid())
  type        String
  industry    String?
  url         String?
  name        String
  description String?
  data        Json?
  score       Int?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([type])
  @@index([industry])
  @@map("ai_references")
}

model AiRule {
  id          String   @id @default(cuid())
  title       String
  rule        String
  industry    String?
  isActive    Boolean  @default(true)
  priority    Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("ai_rules")
}

model AiFeedback {
  id               String   @id @default(cuid())
  leadId           String?
  recommendationId String?
  type             String
  rating           Int
  comment          String?
  originalText     String?
  createdAt        DateTime @default(now())

  @@index([type])
  @@map("ai_feedback")
}

model ConversionInsight {
  id              String   @id @default(cuid())
  leadId          String
  industry        String
  city            String?
  score           Int?
  winningFactors  Json?
  outreachMethod  String?
  timeToConvert   Int?
  monthlyValue    String?
  notes           String?
  createdAt       DateTime @default(now())

  @@index([industry])
  @@map("conversion_insights")
}

enum CampaignStatus {
  DRAFT
  SCHEDULED
  SENDING
  SENT
  FAILED
}
